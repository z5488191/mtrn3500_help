//-----------------------------------------
// Helper: full system via ThreadManagement
//-----------------------------------------
void RunTMM()
{
    ThreadManagement^ tmm = gcnew ThreadManagement();

    if (tmm->setupSharedMemory() != SUCCESS)
    {
        Console::WriteLine("Failed to set up shared memory");
        Console::ReadLine();
        return;
    }

    // This starts LiDAR, GNSS, Display threads (and later Controller, VehicleControl, CrashAvoidance)
    tmm->threadFunction();
}

//-----------------------------------------
// Test 1: Display + FakeLiDAR -> MATLAB
//-----------------------------------------
void RunTest_DisplayFake()
{
    SM_ThreadManagement^ smTM   = gcnew SM_ThreadManagement;
    SM_LiDAR^            smLiDAR = gcnew SM_LiDAR;
    SM_GNSS^             smGNSS  = gcnew SM_GNSS;

    smTM->shutdown  = 0;
    smTM->heartbeat = 0;
    smTM->ThreadBarrier = gcnew Barrier(1);

    Display^ disp = gcnew Display(smTM, smLiDAR, smGNSS);

    Console::WriteLine("Running DISPLAY test with FakeLiDAR");
    Console::WriteLine("Make sure MATLAB display script is running");

    if (disp->connect("127.0.0.1", 28000) != SUCCESS)
    {
        Console::WriteLine("Display connect failed");
        Console::ReadLine();
        return;
    }

    for (int i = 0; i < 200; ++i)
    {
        smTM->heartbeat |= bit_DISPLAY;

        // fill SM_LiDAR with fake data
        disp->FakeLiDAR();

        // send to MATLAB
        disp->communicate();

        Thread::Sleep(50);
    }

    Console::WriteLine("Display FakeLiDAR test complete, press Enter to exit");
    Console::ReadLine();
}

//-----------------------------------------------------
// Test 2: Real LiDAR + Display -> MATLAB point cloud
//-----------------------------------------------------
void RunTest_LiDARDisplayReal()
{
    SM_ThreadManagement^ smTM   = gcnew SM_ThreadManagement;
    SM_LiDAR^            smLiDAR = gcnew SM_LiDAR;
    SM_GNSS^             smGNSS  = gcnew SM_GNSS;

    smTM->shutdown  = 0;
    smTM->heartbeat = 0;
    smTM->ThreadBarrier = gcnew Barrier(1);

    LiDAR^   lidar = gcnew LiDAR(smTM, smLiDAR);
    Display^ disp  = gcnew Display(smTM, smLiDAR, smGNSS);

    Console::WriteLine("Connecting Display to MATLAB on 127.0.0.1:28000");
    if (disp->connect("127.0.0.1", 28000) != SUCCESS)
    {
        Console::WriteLine("Display connect failed");
        Console::ReadLine();
        return;
    }

    Console::WriteLine("Connecting LiDAR to WEEDER on {0}:23000",
        gcnew String(WEEDER_ADDRESS));
    if (lidar->connect(gcnew String(WEEDER_ADDRESS), 23000) != SUCCESS)
    {
        Console::WriteLine("LiDAR connect failed");
        Console::ReadLine();
        return;
    }

    Console::WriteLine("Real LiDAR + Display test running");
    Console::WriteLine("Make sure LiDAR service is running on the weeder VM");

    for (int i = 0; i < 200; ++i)
    {
        // LiDAR step
        smTM->heartbeat |= bit_LiDAR;

        error_state commResult = lidar->communicate();
        if (commResult == ERR_CONNECTION)
        {
            Console::WriteLine("LiDAR connection lost");
            break;
        }

        if (commResult == SUCCESS && lidar->checkData() == SUCCESS)
        {
            lidar->processSharedMemory();
        }

        // Display step
        smTM->heartbeat |= bit_DISPLAY;
        disp->communicate();

        Thread::Sleep(50);
    }

    Console::WriteLine("LiDAR + Display test complete, press Enter to exit");
    Console::ReadLine();
}

//-----------------------------------------
// Test 3: GNSS only – prints CRC + UTM data
//-----------------------------------------
void RunTest_GNSS()
{
    SM_ThreadManagement^ smTM  = gcnew SM_ThreadManagement;
    SM_GNSS^             smGNSS = gcnew SM_GNSS;

    smTM->shutdown  = 0;
    smTM->heartbeat = 0;
    smTM->ThreadBarrier = gcnew Barrier(1);

    GNSS^ gnss = gcnew GNSS(smTM, smGNSS);

    Console::WriteLine("Connecting GNSS to WEEDER on {0}:24000",
        gcnew String(WEEDER_ADDRESS));
    if (gnss->connect(gcnew String(WEEDER_ADDRESS), 24000) != SUCCESS)
    {
        Console::WriteLine("GNSS connect failed");
        Console::ReadLine();
        return;
    }

    Console::WriteLine("GNSS test running");
    Console::WriteLine("You should see northing, easting, height, and CRCs");

    for (int i = 0; i < 100; ++i)
    {
        smTM->heartbeat |= bit_GNSS;

        error_state commResult = gnss->communicate();
        if (commResult == ERR_CONNECTION)
        {
            Console::WriteLine("GNSS connection lost");
            break;
        }

        if (commResult == SUCCESS && gnss->checkData() == SUCCESS)
        {
            gnss->processSharedMemory();

            // also show what is in shared memory
            Console::WriteLine("SM_GNSS: North = {0:F3} m, East = {1:F3} m, Height = {2:F3} m",
                smGNSS->northing, smGNSS->easting, smGNSS->height);
        }

        Thread::Sleep(100);
    }

    Console::WriteLine("GNSS test complete, press Enter to exit");
    Console::ReadLine();
}

